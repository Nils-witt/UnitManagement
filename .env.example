ADDR=:8080
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
SESSION_TTL=24h
# Key that signs the JWT access tokens: at least 32 bytes, e.g. the output of
# `openssl rand -base64 48`. If empty, a random key is used and every sign-in
# ends when the server restarts.
JWT_SECRET=
# Mark the short-lived SSO sign-in cookie as HTTPS-only.
COOKIE_SECURE=false
# Name of this deployment shown in the page title, header and login page.
# Leave empty to show the product name.
INSTANCE_NAME=DevBook.Units
# Reverse proxies (comma-separated IPs or CIDRs) whose X-Forwarded-For and
# X-Real-IP headers identify the client. Leave empty when not behind a proxy.
TRUSTED_PROXIES=
# Origins of other web apps allowed to call the API from the browser,
# comma-separated, e.g. https://maps.example.com. Leave empty for same-origin
# only.
CORS_ALLOWED_ORIGINS=
# How long audit log entries are kept, e.g. 2160h for 90 days. 0 keeps them
# forever.
AUDIT_LOG_RETENTION=0
# How long unit position history is kept, e.g. 720h for 30 days. 0 keeps it
# forever. Each unit's newest position is always kept.
POSITION_HISTORY_RETENTION=0
# Directory holding this instance's server UUID and RSA key pair, which it
# authenticates to the instances it syncs units from with. Created on first
# start; keep it on persistent storage.
KEYS_DIR=./data/keys
# Local administrator, created at startup when no account is an administrator
# and ADMIN_USERNAME is unused (existing accounts are never promoted).
# ADMIN_PASSWORD is optional when SSO is configured (use OIDC_ADMIN_GROUP).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional SSO via OpenID Connect: set all four to enable.
# Register OIDC_REDIRECT_URL (<public URL>/api/auth/oidc/callback) at the provider.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# Label of the SSO button on the login page.
OIDC_DISPLAY_NAME=SSO
# Every SSO sign-in syncs the user's group memberships from OIDC_GROUPS_CLAIM
# (read from the ID token, else userinfo); see the Groups page.
# Sync the administrator role of SSO accounts from the provider's groups: on
# every sign-in, members of OIDC_ADMIN_GROUP become administrators and
# everyone else loses the role. Leave empty to manage roles in the app.
OIDC_ADMIN_GROUP=
# Claim listing the user's groups.
OIDC_GROUPS_CLAIM=groups
# Extra scopes to request, e.g. "groups" for Dex.
OIDC_EXTRA_SCOPES=

# Optional: accept JWT access tokens from an OIDC provider directly as API
# bearer tokens (Authorization: Bearer <token>), without the browser sign-in.
# Setting OIDC_ACCESS_TOKEN_AUDIENCE enables it: comma-separated values, of
# which the token's aud claim must contain at least one. ID tokens are never
# accepted. Accounts are provisioned and groups synced as for SSO sign-in.
OIDC_ACCESS_TOKEN_AUDIENCE=
# Additional issuers (comma-separated issuer URLs) whose access tokens are
# trusted alongside the SSO provider's. Works without SSO login configured;
# requires OIDC_ACCESS_TOKEN_AUDIENCE.
OIDC_ACCESS_TOKEN_ISSUERS=
