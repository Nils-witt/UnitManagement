ADDR=:8080
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
SESSION_TTL=24h
COOKIE_SECURE=false
# Name of this deployment shown in the page title, header and login page.
# Leave empty to show the product name.
INSTANCE_NAME=DevBook.Units
# Reverse proxies (comma-separated IPs or CIDRs) whose X-Forwarded-For and
# X-Real-IP headers identify the client. Leave empty when not behind a proxy.
TRUSTED_PROXIES=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional SSO via OpenID Connect: set all four to enable.
# Register OIDC_REDIRECT_URL (<public URL>/api/auth/oidc/callback) at the provider.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# Label of the SSO button on the login page.
OIDC_DISPLAY_NAME=SSO
# Sync the administrator role of SSO accounts from the provider's groups: on
# every sign-in, members of OIDC_ADMIN_GROUP become administrators and
# everyone else loses the role. Leave empty to manage roles in the app.
OIDC_ADMIN_GROUP=
# Claim listing the user's groups (read from the ID token, else userinfo).
OIDC_GROUPS_CLAIM=groups
# Extra scopes to request, e.g. "groups" for Dex.
OIDC_EXTRA_SCOPES=
